{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qwen capability-demand response",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "results"],
  "properties": {
    "status": {"const": "ok"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_code", "status", "candidate_item_codes", "reason_code", "evidence", "confidence"],
        "properties": {
          "dimension_code": {"type": "string", "pattern": "^D[0-9]{2}$"},
          "status": {"enum": ["Met", "Met with accommodation", "Gap", "Unknown"]},
          "candidate_item_codes": {"type": "array", "items": {"type": "string"}},
          "reason_code": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "object"}},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    }
  }
}