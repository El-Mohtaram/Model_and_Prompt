{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Candidate M1 to M3, version 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "job_category",  "disability", "skills", "cv_text",
               "capabilities", "input_methods", "usable_formats",
               "communication_channels", "at_needs", "preferences"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "candidate_id": { "type": "string", "pattern": "^cand_[0-9]{4,}$" },
    "job_category": { "enum": ["mobility", "office", "both"] },
    "disability": { "type": "string" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "level": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "cv_text": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] }
    },
    "capabilities": { "type": "array", "items": { "$ref": "#/definitions/capability" } },
    "input_methods": { "type": "array", "items": { "type": "string" } },
    "usable_formats": { "type": "array", "items": { "type": "string" } },
    "communication_channels": { "type": "array", "items": { "type": "string" } },
    "at_needs": { "type": "array", "items": { "type": "string" } },
    "preferences": {
      "type": "object",
      "required": ["remote", "location"],
      "properties": {
        "remote": { "type": "boolean" },
        "location": { "type": ["string", "null"] }
      }
    }
  },
  "definitions": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_code"],
      "properties": {
        "item_code": {
          "type": "string",
          "pattern": "^(PC[0-9]{2}|OF[0-9]{2}|WH_D[1-6]_[0-9]{1,2}|H[1-3])$"
        },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "method": { "enum": ["self_reported", "tested"] },
        "score": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 }
      },
      "allOf": [
        { "anyOf": [{ "required": ["value"] }, { "required": ["score"] }] },
        { "not": { "required": ["score", "value"] } },
        {
          "if": { "required": ["value"], "properties": { "value": { "type": "number" } } },
          "then": { "required": ["unit", "method"] }
        }
      ]
    }
  }
}